---
import { useTranslations, localizedPath } from "../i18n/utils";
import { locales, type Locale } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const links = [
  { href: localizedPath(lang, ""), key: "nav.home" as const },
  { href: localizedPath(lang, "products"), key: "nav.products" as const },
  { href: localizedPath(lang, "certificates"), key: "nav.certificates" as const },
  { href: localizedPath(lang, "catalogue"), key: "nav.catalogue" as const },
  { href: localizedPath(lang, "contact"), key: "nav.contact" as const },
];
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={localizedPath(lang, "")}>
      RONESANS TRADING
      <small>{t("brand.tagline")}</small>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {t(link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} />
  </div>
</header>
