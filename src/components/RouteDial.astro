---
// The site's one signature visual element: a compass/gauge-style dial
// whose needle sweeps further as the visitor scrolls through the hero --
// a literal "tracing the route" from manufacturer to EU market. Built as
// inline SVG (not an <img>) so ScrollFX.astro can rotate the needle
// directly via its id.
interface Props {
  size?: number;
}
const { size = 440 } = Astro.props;
---

<svg
  id="route-dial"
  viewBox="0 0 480 480"
  width={size}
  height={size}
  role="img"
  aria-label="Illustrative compass dial representing the route from manufacturer to EU market"
>
  <defs>
    <radialGradient id="dialFace" cx="35%" cy="30%" r="75%">
      <stop offset="0%" stop-color="#131a26" />
      <stop offset="100%" stop-color="#0a0e16" />
    </radialGradient>
    <filter id="needleGlow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="7" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- outer registration ring with tick marks, echoes the card corner marks used site-wide -->
  <circle cx="240" cy="240" r="196" fill="none" stroke="#212a38" stroke-width="1.5" />
  <g stroke="#212a38" stroke-width="1.5">
    {Array.from({ length: 24 }).map((_, i) => {
      const angle = (i * 15 * Math.PI) / 180;
      const inner = 188;
      const outer = i % 6 === 0 ? 172 : 182;
      const x1 = 240 + inner * Math.cos(angle);
      const y1 = 240 + inner * Math.sin(angle);
      const x2 = 240 + outer * Math.cos(angle);
      const y2 = 240 + outer * Math.sin(angle);
      return (
        <line
          x1={x1}
          y1={y1}
          x2={x2}
          y2={y2}
          stroke={i % 6 === 0 ? "#3b6dff" : "#212a38"}
        />
      );
    })}
  </g>

  <!-- dashed mid ring -->
  <circle
    cx="240"
    cy="240"
    r="150"
    fill="none"
    stroke="#3b6dff"
    stroke-opacity="0.35"
    stroke-width="1.5"
    stroke-dasharray="2 6"
  />

  <!-- dial face -->
  <circle cx="240" cy="240" r="118" fill="url(#dialFace)" />

  <!-- needle: id'd so the scroll script can rotate this group about the
       dial center as the visitor scrolls through the hero -->
  <g id="route-needle" style="transform-origin: 240px 240px;">
    <line
      x1="240"
      y1="240"
      x2="350"
      y2="165"
      stroke="#3b6dff"
      stroke-width="3.5"
      stroke-linecap="round"
      filter="url(#needleGlow)"
    />
  </g>

  <circle cx="240" cy="240" r="11" fill="#3b6dff" />
  <circle cx="240" cy="240" r="4" fill="#05070c" />
</svg>
