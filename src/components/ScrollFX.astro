---
// Included once, globally, via Layout.astro. Handles a fade/slide-up
// reveal for any element marked `.reveal`, as it enters the viewport --
// used across every page for section content. Skipped entirely for
// prefers-reduced-motion -- content is just shown immediately, no motion.
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");

  if (prefersReducedMotion) {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  } else {
    revealEls.forEach((el) => {
      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () => el.classList.add("is-visible"),
      });
    });
  }
</script>
