---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollFX from "../components/ScrollFX.astro";
import type { Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
}

const { lang, title, description = "" } = Astro.props;
const siteName = "Ronesans Trading";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{title} · {siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      No analytics, no third-party embeds, no external font requests
      by default. If you add any of those later, revisit the cookie
      banner question in the project README.
    -->
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollFX />
  </body>
</html>
