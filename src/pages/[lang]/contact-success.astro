---
import Layout from "../../layouts/Layout.astro";
import { locales, type Locale } from "../../i18n/ui";
import { localizedPath } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const copy: Record<Locale, { title: string; body: string; back: string }> = {
  en: {
    title: "Message sent",
    body: "Thanks for getting in touch -- we'll reply by email shortly.",
    back: "Back to home",
  },
  de: {
    title: "Nachricht gesendet",
    body: "Vielen Dank für Ihre Nachricht -- wir melden uns in Kürze per E-Mail.",
    back: "Zurück zur Startseite",
  },
  fr: {
    title: "Message envoyé",
    body: "Merci de nous avoir contactés -- nous répondrons par e-mail sous peu.",
    back: "Retour à l'accueil",
  },
};
const c = copy[lang];
---

<Layout lang={lang} title={c.title}>
  <section class="section wrap">
    <h1>{c.title}</h1>
    <p class="lead">{c.body}</p>
    <a class="btn btn-secondary" href={localizedPath(lang, "")}>{c.back}</a>
  </section>
</Layout>
