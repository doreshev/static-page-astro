---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { locales, type Locale } from "../../i18n/ui";
import { useTranslations, withLangFallback } from "../../i18n/utils";
import posterPhoto from "../../content/facility/images/factory-nameplate.jpg";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const posterImage = await getImage({ src: posterPhoto, width: 1200 });

// Same English-fallback pattern used across products/certificates.
const allPhotos = await getCollection("facility");
const photos = withLangFallback(allPhotos, lang).sort(
  (a, b) => a.data.order - b.data.order
);

const fullImages = await Promise.all(
  photos.map((photo) => getImage({ src: photo.data.image, width: 1600 }))
);
---

<Layout lang={lang} title={t("facility.title")} description={t("facility.lead")}>
  <section class="section wrap reveal">
    <div class="section__head">
      <p class="eyebrow">{t("nav.facility")}</p>
      <h1>{t("facility.title")}</h1>
      <p class="lead">{t("facility.lead")}</p>
    </div>

    <!--
      PLACEHOLDER VIDEO -- public/videos/facility-overview.mp4 is currently
      an empty 0-byte file. Replace that file (same name) with the real
      video and this block works with no code changes. See README for
      recommended format/size. No autoplay: a real click-to-play control
      respects bandwidth and accessibility better than an autoplaying
      background clip, especially for a file this size.
    -->
    <div class="video-block reveal">
      <video controls preload="none" poster={posterImage.src} width="1200" height="675">
        <source src="/videos/facility-overview.mp4" type="video/mp4" />
        {t("facility.video.fallback")}{" "}
        <a href="/videos/facility-overview.mp4">facility-overview.mp4</a>
      </video>
    </div>

    <div class="grid">
      {
        photos.map((photo, i) => {
          const dialogId = `facility-dialog-${photo.data.group}`;
          return (
            <div class="card cert-card">
              <button
                type="button"
                class="cert-trigger"
                data-lightbox-target={dialogId}
                aria-haspopup="dialog"
                aria-label={`${t("certificates.viewLarger")}: ${photo.data.caption}`}
              >
                <Image
                  class="card__image"
                  src={photo.data.image}
                  alt={photo.data.imageAlt}
                  width={400}
                  height={300}
                />
              </button>
              <p class="card__desc">{photo.data.caption}</p>
              {photo.data.lang !== lang && (
                <span class="card__meta">{photo.data.lang.toUpperCase()}</span>
              )}

              <dialog id={dialogId} class="lightbox">
                <button
                  type="button"
                  class="lightbox__close"
                  data-lightbox-close
                  aria-label={t("certificates.close")}
                >
                  ×
                </button>
                <img
                  class="lightbox__image"
                  src={fullImages[i].src}
                  width={fullImages[i].attributes.width}
                  height={fullImages[i].attributes.height}
                  alt={photo.data.imageAlt}
                  loading="lazy"
                />
                <p class="lightbox__caption">{photo.data.caption}</p>
              </dialog>
            </div>
          );
        })
      }
    </div>

    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-lightbox-target]").forEach((trigger) => {
        const dialog = document.getElementById(trigger.dataset.lightboxTarget!) as HTMLDialogElement | null;
        if (!dialog) return;
        trigger.addEventListener("click", () => dialog.showModal());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
      });
    </script>
  </section>
</Layout>
