---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { locales, type Locale } from "../../i18n/ui";
import { useTranslations, localizedPath, withLangFallback } from "../../i18n/utils";
import heroPhoto from "../../content/facility/images/pipe-tunnel.jpg";
import posterPhoto from "../../content/facility/images/factory-nameplate.jpg";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const allProducts = await getCollection("products");
const featured = withLangFallback(allProducts, lang)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posterImage = await getImage({ src: posterPhoto, width: 1200 });

const titleLines = t("home.title").split("\n");
---

<Layout lang={lang} title={t("home.title").replace(/\n/g, " ")} description={t("home.lead")}>
  <section class="hero wrap">
    <div class="hero__bg" aria-hidden="true">
      <Image src={heroPhoto} alt="" width={1600} />
    </div>
    <div class="hero__content">
      <p class="eyebrow"><span class="eyebrow__index">01 —</span> {t("home.eyebrow")}</p>
      <h1 class="hero__title">
        {titleLines.map((line, i) => (
          <span class={i === titleLines.length - 1 ? "accent" : ""} style="display:block;">
            {line}
          </span>
        ))}
      </h1>
      <p class="lead hero__lead">{t("home.lead")}</p>
      <div class="hero__actions">
        <a class="btn" href={localizedPath(lang, "products")}>{t("home.cta")}</a>
      </div>
      <p class="hero__scrollcue">{t("home.scrollcue")} ↓</p>
    </div>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">02 —</span> {t("home.intro.eyebrow")}</p>
      <h2>{t("home.intro.title")}</h2>
      <p>{t("home.intro.body")}</p>
    </div>

    <!--
      PLACEHOLDER VIDEO -- public/videos/facility-overview.mp4 is currently
      an empty 0-byte file. Replace that file (same name) with the real
      video and this block works with no code changes. No autoplay: a
      real click-to-play control respects bandwidth and accessibility
      better than an autoplaying background clip.
    -->
    <div class="video-block">
      <video controls preload="none" poster={posterImage.src} width="1200" height="675">
        <source src="/videos/facility-overview.mp4" type="video/mp4" />
        {t("facility.video.fallback")}{" "}
        <a href="/videos/facility-overview.mp4">facility-overview.mp4</a>
      </video>
    </div>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">03 —</span> {t("home.products.eyebrow")}</p>
      <h2>{t("home.products.title")}</h2>
    </div>
    <div class="grid">
      {
        featured.map((product) => (
          <ProductCard
            lang={lang}
            group={product.data.group}
            title={product.data.title}
            shortDescription={product.data.shortDescription}
            image={product.data.image}
            imageAlt={product.data.imageAlt}
            sourceLang={product.data.lang}
          />
        ))
      }
    </div>
    <p style="margin-top:28px;">
      <a class="btn btn-secondary" href={localizedPath(lang, "products")}>
        {t("home.products.viewAll")}
      </a>
    </p>
  </section>

  <section class="section wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">04 —</span> {t("home.contact.eyebrow")}</p>
      <h2>{t("home.contact.title")}</h2>
      <p class="lead">{t("home.contact.body")}</p>
    </div>
    <a class="btn" href={localizedPath(lang, "contact")}>{t("nav.contact")}</a>
  </section>
</Layout>
