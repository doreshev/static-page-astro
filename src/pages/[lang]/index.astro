---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import RouteDial from "../../components/RouteDial.astro";
import { getCollection } from "astro:content";
import { locales, type Locale } from "../../i18n/ui";
import { useTranslations, localizedPath, withLangFallback } from "../../i18n/utils";
import heroPhoto from "../../content/facility/images/pipe-tunnel.jpg";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const allProducts = await getCollection("products");
const featured = withLangFallback(allProducts, lang)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allPhotos = await getCollection("facility");
const facilityTeaser = withLangFallback(allPhotos, lang)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const titleLines = t("home.title").split("\n");
const aboutParagraphs = t("home.about.body").split("\n\n");
---

<Layout lang={lang} title={t("home.title").replace(/\n/g, " ")} description={t("home.lead")}>
  <section class="hero wrap">
    <div class="hero__bg" aria-hidden="true">
      <Image src={heroPhoto} alt="" width={1600} />
    </div>
    <div class="hero__grid">
      <div>
        <p class="eyebrow"><span class="eyebrow__index">01 —</span> {t("home.eyebrow")}</p>
        <h1 class="hero__title">
          {titleLines.map((line, i) => (
            <span class={i === titleLines.length - 1 ? "accent" : ""} style="display:block;">
              {line}
            </span>
          ))}
        </h1>
        <p class="lead hero__lead">{t("home.lead")}</p>
        <div class="hero__actions">
          <a class="btn" href={localizedPath(lang, "products")}>{t("home.cta")}</a>
        </div>
        <p class="hero__scrollcue">{t("home.scrollcue")} ↓</p>
      </div>
      <div class="hero__graphic" aria-hidden="true">
        <RouteDial size={340} />
      </div>
    </div>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">02 —</span> {t("home.about.eyebrow")}</p>
      <h2>{t("home.about.title")}</h2>
      {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">03 —</span> {t("home.facility.eyebrow")}</p>
      <h2>{t("home.facility.title")}</h2>
      <p class="lead">{t("home.facility.body")}</p>
    </div>
    <div class="grid">
      {
        facilityTeaser.map((photo) => (
          <a class="card" href={localizedPath(lang, "facility")}>
            <Image
              class="card__image"
              src={photo.data.image}
              alt={photo.data.imageAlt}
              width={400}
              height={300}
            />
            <p class="card__desc">{photo.data.caption}</p>
            {photo.data.lang !== lang && (
              <span class="card__meta">{photo.data.lang.toUpperCase()}</span>
            )}
          </a>
        ))
      }
    </div>
    <p style="margin-top:28px;">
      <a class="btn btn-secondary" href={localizedPath(lang, "facility")}>
        {t("home.facility.cta")}
      </a>
    </p>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">04 —</span> {t("home.products.eyebrow")}</p>
      <h2>{t("home.products.title")}</h2>
    </div>
    <div class="grid">
      {
        featured.map((product) => (
          <ProductCard
            lang={lang}
            group={product.data.group}
            title={product.data.title}
            shortDescription={product.data.shortDescription}
            image={product.data.image}
            imageAlt={product.data.imageAlt}
            sourceLang={product.data.lang}
          />
        ))
      }
    </div>
    <p style="margin-top:28px;">
      <a class="btn btn-secondary" href={localizedPath(lang, "products")}>
        {t("home.products.viewAll")}
      </a>
    </p>
  </section>

  <section class="section section--bordered wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">05 —</span> {t("home.certifications.eyebrow")}</p>
      <h2>{t("home.certifications.title")}</h2>
      <p class="lead">{t("home.certifications.body")}</p>
    </div>
    <a class="btn btn-secondary" href={localizedPath(lang, "certificates")}>
      {t("home.certifications.cta")}
    </a>
  </section>

  <section class="section wrap reveal">
    <div class="section__head">
      <p class="eyebrow"><span class="eyebrow__index">06 —</span> {t("home.contact.eyebrow")}</p>
      <h2>{t("home.contact.title")}</h2>
      <p class="lead">{t("home.contact.body")}</p>
    </div>
    <a class="btn" href={localizedPath(lang, "contact")}>{t("nav.contact")}</a>
  </section>
</Layout>
