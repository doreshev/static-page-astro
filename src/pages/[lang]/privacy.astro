---
import Layout from "../../layouts/Layout.astro";
import { locales, type Locale } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout lang={lang} title={t("privacy.title")}>
  <section class="section wrap" style="max-width:75ch;">
    <p class="eyebrow">{t("footer.privacy")}</p>
    <h1>{t("privacy.title")}</h1>

    <p style="background:#fff;border:1px solid var(--line);padding:16px;font-family:var(--font-mono);font-size:0.85rem;color:var(--steel);">
      PLACEHOLDER -- this page is not legal text. Replace it with a privacy
      notice reviewed by your company's legal/data-protection advisor before
      launch. At minimum, a GDPR-compliant notice for a site like this
      typically needs to cover: what data the contact form collects (name,
      email, company, message) and why; the legal basis (e.g. consent, or
      legitimate interest in responding to enquiries); how long it's kept;
      which processors see it (your hosting provider's server logs, your
      email provider); and how someone can request access, correction, or
      deletion of their data. Since Ronesans Trading Lux is registered in Luxembourg,
      the relevant supervisory authority to name here would typically be
      Luxembourg's CNPD (Commission Nationale pour la Protection des
      Données) -- confirm this with your advisor before publishing.
    </p>
  </section>
</Layout>
