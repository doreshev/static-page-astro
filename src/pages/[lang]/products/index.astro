---
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { locales, type Locale, type UiKey } from "../../../i18n/ui";
import { useTranslations, withLangFallback } from "../../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const allProducts = await getCollection("products");
const products = withLangFallback(allProducts, lang).sort(
  (a, b) => a.data.order - b.data.order
);

// Provisional category order -- see the note in content.config.ts. Any
// category not listed here still renders, just after these three, so
// adding a new category to a product never silently drops it.
const categoryOrder = ["pipes", "membranes-geosynthetics", "other"];
const categories = [
  ...categoryOrder,
  ...new Set(products.map((p) => p.data.category).filter((c) => !categoryOrder.includes(c))),
];
---

<Layout lang={lang} title={t("products.title")} description={t("products.lead")}>
  <section class="section wrap reveal">
    <div class="section__head">
      <p class="eyebrow">{t("nav.products")}</p>
      <h1>{t("products.title")}</h1>
      <p class="lead">{t("products.lead")}</p>
    </div>

    {
      categories.map((category) => {
        const items = products.filter((p) => p.data.category === category);
        if (items.length === 0) return null;
        const labelKey = `category.${category}` as UiKey;
        return (
          <div class="product-category">
            <h2 class="product-category__title">{t(labelKey)}</h2>
            <div class="grid">
              {items.map((product) => (
                <ProductCard
                  lang={lang}
                  group={product.data.group}
                  title={product.data.title}
                  shortDescription={product.data.shortDescription}
                  image={product.data.image}
                  imageAlt={product.data.imageAlt}
                  sourceLang={product.data.lang}
                />
              ))}
            </div>
          </div>
        );
      })
    }
  </section>
</Layout>
